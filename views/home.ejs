<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Game Center</title>
    <link rel="stylesheet" href="/css/home.css">
</head>

<body>
    <div class="container">
        <h1>Game Center</h1>
        <div class="subtitle">Select a game to play</div>

        <div class="tabs">
            <button class="tab-btn active" onclick="showGame('tic-tac-toe')">Tic Tac Toe</button>
            <button class="tab-btn" onclick="showGame('hangman')">Hangman</button>
            <button class="tab-btn" onclick="showGame('rps')">Rock Paper Scissors</button>
        </div>

        <!-- Tic Tac Toe Section -->
        <div id="tic-tac-toe" class="game-section active">
            <div class="ttt-grid" id="tttGrid">
                <!-- Cells generated by JS -->
            </div>
            <div id="tttResult" class="game-result"></div>
            <button class="control-btn" onclick="resetTTT()">Restart Game</button>
        </div>

        <!-- Hangman Section -->
        <div id="hangman" class="game-section">
            <svg class="hangman-drawing" viewBox="0 0 100 120">
                <!-- Base -->
                <line x1="10" y1="110" x2="30" y2="110" />
                <line x1="20" y1="110" x2="20" y2="10" />
                <line x1="20" y1="10" x2="60" y2="10" />
                <line x1="60" y1="10" x2="60" y2="30" />

                <!-- Body Parts (Hidden initially) -->
                <circle id="hm-head" cx="60" cy="40" r="10" style="display:none" />
                <line id="hm-body" x1="60" y1="50" x2="60" y2="80" style="display:none" />
                <line id="hm-arm-l" x1="60" y1="60" x2="45" y2="70" style="display:none" />
                <line id="hm-arm-r" x1="60" y1="60" x2="75" y2="70" style="display:none" />
                <line id="hm-leg-l" x1="60" y1="80" x2="45" y2="100" style="display:none" />
                <line id="hm-leg-r" x1="60" y1="80" x2="75" y2="100" style="display:none" />
            </svg>
            <div id="hmWord" class="word-display"></div>
            <div id="hmKeyboard" class="keyboard"></div>
            <div id="hmResult" class="game-result"></div>
            <button class="control-btn" onclick="resetHangman()">New Word</button>
        </div>

        <!-- Rock Paper Scissors Section -->
        <div id="rps" class="game-section">
            <div class="rps-choices">
                <button class="rps-btn" onclick="playRPS('rock')">🪨</button>
                <button class="rps-btn" onclick="playRPS('paper')">📄</button>
                <button class="rps-btn" onclick="playRPS('scissors')">✂️</button>
            </div>
            <div style="color: #808080; font-size: 0.9rem; margin-bottom: 5px;">VS</div>
            <div id="rpsCompChoice" style="font-size: 2rem; min-height: 48px; margin-bottom: 15px;">❓</div>
            <div id="rpsResult" class="game-result"></div>
        </div>

        <button class="logout-btn" onclick="location.href='/logout'">Logout</button>
    </div>

    <script src="/js/game.js"></script>
</body>

</html>